# ProxyAPI (OpenAI-совместимый) — ключ sk-...
PROXY_API=your_proxy_api_key_here

# GigaChat (Sber) — для улучшения промптов и вспомогательных задач
GIGACHAT_CLIENT_ID=your_gigachat_client_id
GIGACHAT_CLIENT_SECRET=your_gigachat_client_secret

# Модели ProxyAPI
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# История
HISTORY_FILE=history.json
MAX_HISTORY_ITEMS=10

# Парсер (Selenium)
PARSER_TIMEOUT=30
PARSER_HEADLESS=true
